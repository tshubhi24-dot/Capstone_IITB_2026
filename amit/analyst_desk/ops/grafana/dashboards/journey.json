    {"id": 3, "title": "Actual MCP calls", "type": "stat", "datasource": {"type": "prometheus", "uid": "analyst-prometheus"}, "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6}, "targets": [{"expr": "sum(analyst_tool_calls_total)", "refId": "A"}]},
    {"id": 4, "title": "Model calls — zero in this rehearsal", "type": "stat", "datasource": {"type": "prometheus", "uid": "analyst-prometheus"}, "gridPos": {"x": 0, "y": 6, "w": 8, "h": 6}, "targets": [{"expr": "analyst_model_calls_total", "refId": "A"}]}
